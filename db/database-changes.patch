diff --git a/db/init/00-roles.sh b/db/init/00-roles.sh
new file mode 100755
index 0000000000000000000000000000000000000000..910f73b5a18e4951a77c1e1ea0c255210861312e
--- /dev/null
+++ b/db/init/00-roles.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -Eeuo pipefail
+
+psql --set=ON_ERROR_STOP=1 --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" \
+    --set=database_name="$POSTGRES_DB" \
+    --set=migration_password="$MIGRATION_DATABASE_PASSWORD" \
+    --set=app_password="$APP_DATABASE_PASSWORD" <<'SQL'
+CREATE ROLE shop_migrator LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION
+    PASSWORD :'migration_password';
+CREATE ROLE shop_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION
+    PASSWORD :'app_password';
+
+ALTER DATABASE :"database_name" OWNER TO shop_migrator;
+REVOKE ALL ON DATABASE :"database_name" FROM PUBLIC;
+GRANT CONNECT ON DATABASE :"database_name" TO shop_migrator, shop_app;
+
+ALTER SCHEMA public OWNER TO shop_migrator;
+REVOKE CREATE ON SCHEMA public FROM PUBLIC;
+GRANT USAGE ON SCHEMA public TO shop_app;
+SQL
diff --git a/db/scripts/grant-app-permissions.sql b/db/scripts/grant-app-permissions.sql
new file mode 100644
index 0000000000000000000000000000000000000000..07279efa4e0941c1798b4d6724da4d167421ef24
--- /dev/null
+++ b/db/scripts/grant-app-permissions.sql
@@ -0,0 +1,21 @@
+-- Run as shop_migrator after applying migrations configured in db/alembic.ini.
+\set ON_ERROR_STOP on
+
+GRANT SELECT, INSERT, UPDATE, DELETE ON TABLE
+    public.users, public.categories, public.products,
+    public.carts, public.cart_items, public.orders, public.order_items,
+    public.payments, public.order_idempotency_keys
+TO shop_app;
+
+GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO shop_app;
+GRANT USAGE ON TYPE public.order_status, public.payment_status TO shop_app;
+
+ALTER DEFAULT PRIVILEGES FOR ROLE shop_migrator IN SCHEMA public
+    GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO shop_app;
+ALTER DEFAULT PRIVILEGES FOR ROLE shop_migrator IN SCHEMA public
+    GRANT USAGE, SELECT ON SEQUENCES TO shop_app;
+ALTER DEFAULT PRIVILEGES FOR ROLE shop_migrator IN SCHEMA public
+    GRANT USAGE ON TYPES TO shop_app;
+
+-- Schema migration metadata is owned and maintained by the migration role.
+REVOKE ALL ON TABLE public.alembic_version FROM shop_app;
