# Copy to .env.runtime (ignored by Git).
APP_ENV=local
API_MODE=live
# Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
AUTH_RATE_LIMIT=10
# Only local/test environments can enable payment simulation.
PAYMENTS_MOCK=false
CREATE_DEFAULT_ADMIN=false
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
