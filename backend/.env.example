# Application
APP_NAME=projekt-zespolowy-api
DEBUG=false
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# PostgreSQL (local development credentials only)
DATABASE_URL=postgresql+asyncpg://shop_app:local-app-password@localhost:5432/shop
MIGRATION_DATABASE_URL=postgresql+asyncpg://shop_migrator:local-migrator-password@localhost:5432/shop
# RDS: path to the AWS CA bundle; enables certificate and hostname verification.
# DATABASE_SSL_CA=/run/certs/global-bundle.pem
