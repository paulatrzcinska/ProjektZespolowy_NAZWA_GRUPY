# Application
APP_NAME=projekt-zespolowy-api
DEBUG=false
API_V1_PREFIX=/api/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:8081

# PostgreSQL. The app builds postgresql+asyncpg://DB_USER:DB_PASSWORD@DB_HOST:DB_PORT/DB_NAME.
# Use 127.0.0.1, not localhost: on Windows localhost adds ~2 s per connection.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=shop
DB_USER=shop_app
# Same value as APP_DATABASE_PASSWORD in db/.env.
DB_PASSWORD=
# Alembic only; same value as MIGRATION_DATABASE_PASSWORD in db/.env.
MIGRATION_DB_USER=shop_migrator
MIGRATION_DB_PASSWORD=
# RDS: path to the AWS CA bundle; enables certificate and hostname verification.
# DATABASE_SSL_CA=/run/certs/global-bundle.pem
