# Public API origin only; leave empty for same-origin /api requests.
VITE_API_BASE_URL=

# Vite dev/preview proxy target; not embedded in the production bundle.
API_PROXY_TARGET=http://127.0.0.1:8000

# Mock data: "true" serves the catalogue from src/mocks/data/*.json
# instead of the API. Leave empty or "false" to use the backend.
VITE_USE_MOCK_API=
