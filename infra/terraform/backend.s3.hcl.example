# Optional shared state after an approved bootstrap of the state bucket.
# Add terraform { backend "s3" {} } to versions.tf before initializing this backend.
# The bucket must have versioning, encryption and Block Public Access enabled.
bucket       = "REPLACE_WITH_PROJECT_STATE_BUCKET"
key          = "dev/network/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true
