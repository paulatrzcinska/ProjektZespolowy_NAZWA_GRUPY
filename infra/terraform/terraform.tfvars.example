aws_region   = "eu-central-1"
project_name = "projekt-zespolowy"
environment  = "dev"
vpc_cidr     = "10.0.0.0/16"
api_port     = 8000

# Network-only foundation: no paid NAT Gateway or public Elastic IP.
# A private runtime needs NAT or a separately designed set of VPC endpoints.
enable_nat_gateway = false
